# Copy to .env. Keep real values out of Git. PostgreSQL and Redis are external services.
SITE_URL=http://localhost:8081
ENCRYPTION_KEY=generate-a-random-16-byte-hex-string
AUTH_SECRET=generate-a-random-32-byte-base64-string
# URL-encode credentials. Infisical migrations use the database's public schema.
DB_CONNECTION_URI=postgresql://USER:URL_ENCODED_PASSWORD@POSTGRES_HOST:5432/infisical
DB_POOL_MIN=0
DB_POOL_MAX=5
# External Redis. URL-encode the password and choose a database reserved for Infisical.
REDIS_URL=redis://:URL_ENCODED_PASSWORD@REDIS_HOST:6379/1
